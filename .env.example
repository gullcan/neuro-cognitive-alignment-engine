APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
READINESS_TIMEOUT_SECONDS=2
TIMEZONE=Europe/Istanbul
DEFAULT_USER_ID=owner

# Operational data. SQLite is convenient locally; use PostgreSQL in production.
DATABASE_URL=sqlite+aiosqlite:///./data/neuro_alignment.db

# LangGraph checkpoints: memory | sqlite | postgres
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_SQLITE_PATH=./data/neuro_alignment_checkpoints.db
# Optional when DATABASE_URL already points to PostgreSQL; otherwise the same database is used.
# CHECKPOINT_POSTGRES_URL=postgresql://neuro_alignment:neuro_alignment@localhost:5432/neuro_alignment

# Notion
NOTION_API_TOKEN=
NOTION_DATA_SOURCE_ID=
NOTION_VERIFICATION_TOKEN=
NOTION_API_VERSION=2026-03-11

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=
TELEGRAM_DELIVERY_ENABLED=false

# Reliable Telegram outbox delivery
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LEASE_SECONDS=120

# Deterministic task-monitor policy (all times use TIMEZONE).
TASK_START_GRACE_MINUTES=15
TASK_PROGRESS_DEFAULT_MINUTES=30
BLOCKED_FOLLOW_UP_MINUTES=30
DAY_RECOVERY_HOUR=20
DAY_SUMMARY_HOUR=23

# OpenAI Responses API. Without a key, the deterministic local provider is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Protects scheduler/outbox endpoints when configured.
INTERNAL_API_KEY=change-me
